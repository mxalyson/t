# =====================================================================
#  Configuração do robô perp 2h (v1-congelada)
#  Copie este arquivo para ".env" (na mesma pasta) e preencha.
#  NUNCA compartilhe o .env: ele contém suas chaves.
# =====================================================================

# ---------------- Modo de operação ----------------
# paper = simulação interna com preços reais da Bybit (nenhuma ordem é enviada)
# live  = envia ordens para a Bybit (ambiente escolhido em BYBIT_ENV)
MODE=paper

# Ambiente da Bybit usado quando MODE=live:
#   demo    = conta Demo Trading da Bybit (preços reais, dinheiro fictício)  <- recomendado
#   testnet = testnet da Bybit (preços próprios, pouco realistas)
#   mainnet = conta REAL
BYBIT_ENV=demo
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Trava de segurança para dinheiro real: com BYBIT_ENV=mainnet o robô só
# opera se aqui estiver escrito exatamente EU_ENTENDO_O_RISCO
LIVE_CONFIRM=

# ---------------- Capital ----------------
# Capital máximo usado no cálculo do tamanho das posições (USDT).
# Em paper é o capital inicial. Em live usa min(saldo da conta, CAPITAL_USDT).
CAPITAL_USDT=1000
# Alavancagem configurada em cada par na Bybit (só define a margem exigida;
# o tamanho das posições vem do risco de 0,5% por trade da versão congelada).
LEVERAGE=5

# ---------------- Execução ----------------
# IMPORTANTE (VEREDITO.md): o protocolo OFICIAL da v1 usa execução idêntica ao backtest:
#   ENTRY_MODE=taker, TP_ORDER=market, EXIT_MODE=taker   -> perfil "oficial"
# Qualquer opção maker vira o perfil "maker": uma VARIANTE de execução, registrada em pasta
# separada (runtime/<modo>_maker) e que NÃO conta para a validação da v1.
#
# Entrada: taker = ordem a mercado na abertura da vela seguinte (igual ao backtest)
#          maker = ordem limite PostOnly no topo do livro (taxa maker), reposicionada
#                  enquanto o preço não se afastar mais que MAX_CHASE_BPS
ENTRY_MODE=taker
MAKER_TIMEOUT_SEC=600
REPRICE_SEC=20
MAX_CHASE_BPS=15
# O que fazer se a maker não for executada no prazo: taker (completa a mercado) ou skip (desiste)
MAKER_FALLBACK=taker
# Take profit: market = gatilho a mercado (taxa taker, igual ao backtest)
#              maker  = ordem limite reduce-only parada no preço do TP (taxa maker)
TP_ORDER=market
# Saída por tempo (após 48 velas): taker = mercado (backtest) | maker = PostOnly com prazo, depois mercado
EXIT_MODE=taker
EXIT_MAKER_TIMEOUT_SEC=300
# Stop loss é SEMPRE stop-market (taker), por segurança.

# Taxas usadas no modo paper (Bybit, nível VIP 0)
MAKER_FEE=0.0002
TAKER_FEE=0.00055

# ---------------- Risco ----------------
# Pausa NOVAS entradas se o drawdown (marcado a mercado) passar deste % do pico.
# As posições abertas continuam protegidas pelo stop. Retomar: python run_bot.py --resume
MAX_DRAWDOWN_PCT=15

# ---------------- Telegram ----------------
# Crie um bot com @BotFather (token) e descubra seu chat id com @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Resumo diário às 00:05 UTC (1 = sim)
TELEGRAM_DAILY=1

# ---------------- Operação ----------------
# Retreino mensal automático (dia 1, 00:30 UTC), parte da especificação congelada
AUTO_RETRAIN=1
# Pasta dos registros (vazio = runtime/<modo>_<perfil>, ex.: runtime/paper_oficial)
DATA_DIR=
LOOP_SEC=15
SIGNAL_DELAY_SEC=60
# Não entra se o robô começar mais de X segundos depois do fechamento da vela
MAX_LATE_SEC=900
# Linha de status no terminal a cada X segundos (0 = desliga). A tabela de sinais sai a cada vela.
CONSOLE_STATUS_SEC=300
